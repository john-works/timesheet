{% extends 'base.html.twig' %}
{% import "macros/widgets.html.twig" as widgets %}

{% block main %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">My Weekly Timesheet</h3>
                <div class="card-tools">
                    <strong>{{ weekStart|date('d/m/Y') }} - {{ weekStart|date_modify('+4 days')|date('d/m/Y') }}</strong>
                    {% if app.request.get('id') is not null %}
                        <a href="{{ path('weekly_submission_staff') }}" class="btn btn-sm btn-outline-primary ms-2">
                            <i class="fas fa-arrow-left"></i> Current Week
                        </a>
                    {% endif %}
                </div>
            </div>
            <div class="card-body">
                {% if submission is not null %}
                    <div class="mb-3">
                        <strong>Status:</strong>
                        {% if submission.isDraft %}
                            <span class="badge bg-secondary" style="color:#fff !important;">Draft</span>
                        {% elseif submission.isSubmitted %}
                            <span class="badge bg-primary">Submitted</span>
                        {% elseif submission.isSupervisorApproved %}
                            <span class="badge bg-info">Supervisor Approved</span>
                        {% elseif submission.isManagerApproved %}
                            <span class="badge bg-warning text-dark">Manager Approved - Pending HR</span>
                        {% elseif submission.isApproved %}
                            <span class="badge bg-success">Approved</span>
                        {% elseif submission.isRejected %}
                            <span class="badge bg-danger">Rejected</span>
                        {% endif %}
                        {% if submission.isOvertime %}
                            <span class="badge bg-warning text-dark">Overtime</span>
                        {% endif %}
                    </div>

                    {% if submission.isSubmitted %}
                        <div class="alert alert-info">
                            Submitted on {{ submission.submittedAt|date('d/m/Y H:i') }}.
                            Waiting for supervisor approval.
                        </div>
                    {% endif %}

                    {% if submission.isSupervisorApproved %}
                        <div class="alert alert-info">
                            Approved by supervisor on {{ submission.approvedAt|date('d/m/Y H:i') }}.
                            Waiting for final approval from manager.
                            {% if submission.isOvertime %}
                                <br><strong>Note:</strong> This submission contains overtime ({{ submission.overtimeHours }}h) and requires manager and HR approval.
                            {% endif %}
                        </div>
                    {% endif %}

                    {% if submission.isManagerApproved %}
                        <div class="alert alert-warning">
                            Approved by manager on {{ submission.managerApprovedAt|date('d/m/Y H:i') }}.
                            Waiting for HR approval (overtime: {{ submission.overtimeHours }}h).
                        </div>
                    {% endif %}

                    {% if submission.isApproved %}
                        <div class="alert alert-success">
                            Approved by {{ submission.managerApprovedBy.displayName ?: submission.approvedBy.displayName }} on {{ submission.managerApprovedAt ? submission.managerApprovedAt|date('d/m/Y H:i') : submission.approvedAt|date('d/m/Y H:i') }}.
                            {% if submission.managerNotes %}
                                <br><strong>Notes:</strong> {{ submission.managerNotes }}
                            {% elseif submission.supervisorNotes %}
                                <br><strong>Notes:</strong> {{ submission.supervisorNotes }}
                            {% endif %}
                        </div>
                    {% endif %}

                    {% if submission.isRejected %}
                        <div class="alert alert-danger">
                            <strong>Rejected</strong> by {{ submission.managerApprovedBy ? submission.managerApprovedBy.displayName : submission.approvedBy.displayName }} on {{ submission.managerApprovedAt ? submission.managerApprovedAt|date('d/m/Y H:i') : submission.approvedAt|date('d/m/Y H:i') }}.
                            {% if submission.managerNotes %}
                                <br><strong>Reason:</strong> {{ submission.managerNotes }}
                            {% elseif submission.supervisorNotes %}
                                <br><strong>Reason:</strong> {{ submission.supervisorNotes }}
                            {% endif %}
                            <br><br>
                            <a href="{{ path('timesheet') }}" class="alert-link">Edit your timesheet entries</a>
                            for the week of {{ weekStart|date('d/m/Y') }}, then submit again below.
                        </div>
                    {% endif %}
                {% endif %}

                <div class="mb-3">
                    <strong>Total hours this week:</strong>
                    {% set hours = (totalDuration / 3600)|number_format(2) %}
                    {{ hours }}h
                    {% if totalDuration > 40 * 3600 %}
                        <span class="badge bg-warning text-dark">Overtime: {{ ((totalDuration - 40 * 3600) / 3600)|number_format(1) }}h</span>
                    {% endif %}
                    {% if leaveDays|default([])|length > 0 %}
                        <br><span class="badge bg-info">{{ leaveDays|length }} day(s) on leave</span>
                    {% endif %}
                </div>
                <div class="mb-3">
                    <strong>Current User:</strong>
                    {% if submission.isDraft or submission.isRejected %}
                        {{ app.user.displayName }}
                    {% elseif submission.isApproved %}
                        {{ submission.managerApprovedBy ? submission.managerApprovedBy.displayName : submission.approvedBy.displayName }}
                    {% elseif submission.isSupervisorApproved %}
                        {{ supervisor.supervisor ? supervisor.supervisor.displayName : '-' }}
                    {% elseif submission.isSubmitted %}
                        {{ supervisor ? supervisor.displayName : '-' }}
                    {% endif %}
                </div>

                {% if supervisor is null and departmentUsers|length == 0 %}
                    <div class="alert alert-warning">
                        You do not have a supervisor assigned. Please contact your administrator.
                    </div>
                {% endif %}
                {% if not canSubmit %}
                    <div class="alert alert-info">
                        <i class="fas fa-clock"></i> Weekly timesheets can only be submitted on <strong>Friday at 8:00 AM or later</strong>.
                    </div>
                {% elseif submission.isDraft %}
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#submitModal">
                        <i class="fas fa-paper-plane"></i> Submit to Supervisor
                    </button>
                {% elseif submission.isRejected %}
                    <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#submitModal">
                        <i class="fas fa-redo"></i> Resubmit to Supervisor
                    </button>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="submitModal" tabindex="-1" aria-labelledby="submitModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header {% if submission.isRejected %}bg-warning text-white{% else %}bg-primary text-white{% endif %}">
                <h5 class="modal-title" id="submitModalLabel">
                    <i class="fas fa-check-circle"></i> {% if submission.isRejected %}Resubmit{% else %}Confirm{% endif %} Weekly Timesheet
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="{{ app.request.get('id') ? path('weekly_submission_staff_resubmit', {id: app.request.get('id')}) : path('weekly_submission_staff_submit') }}" method="post">
            <div class="modal-body">
                <div class="alert alert-info mb-3">
                    <strong>Please review your timesheet before {% if submission.isRejected %}resubmitting{% else %}submitting{% endif %}.</strong>
                </div>
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Week:</strong><br>
                        {{ weekStart|date('d/m/Y') }} to {{ weekStart|date_modify('+4 days')|date('d/m/Y') }}
                    </div>
                    <div class="col-md-6">
                        <strong>Total Hours:</strong><br>
                        {% set hours = (totalDuration / 3600)|number_format(2) %}
                        <span class="badge bg-primary" style="font-size: 1.2em; color:#fff !important;">{{ hours }}h</span>
                    </div>
                </div>

                <div class="mb-3 d-flex align-items-center gap-2">
                    <label for="supervisorSelect" class="form-label fw-bold mb-0">
                        <i class="fas fa-user-tie"></i> Supervisor:
                    </label>
                    {% if departmentUsers|length > 0 %}
                    <select name="supervisor_id" id="supervisorSelect" class="form-select form-select-sm" style="max-width:300px" required>
                        <option value="" disabled selected>-- Select your supervisor --</option>
                        {% for u in departmentUsers %}
                            <option value="{{ u.id }}">{{ u.displayName }}</option>
                        {% endfor %}
                    </select>
                    {% else %}
                        <span>{{ supervisor ? supervisor.displayName : '-' }}</span>
                    {% endif %}
                </div>

                <hr>
                <p class="text-muted small mb-0">
                    Once submitted, your timesheet will be sent to your supervisor for approval.
                    You will not be able to modify it until it is either fully approved or
                    {% if submission.isRejected -%}
                        rejected again.
                    {%- else -%}
                        rejected.
                    {%- endif %}
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-paper-plane"></i> {% if submission.isRejected %}Yes, Resubmit{% else %}Yes, Submit Now{% endif %}
                </button>
            </div>
            </form>
        </div>
    </div>
</div>

{% if history|length > 0 %}
<div class="row mt-3">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Submission History</h3>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Week</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th>Stage</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for entry in history %}
                        <tr>
                            <td>{{ entry.weekStart|date('d/m/Y') }} - {{ entry.weekStart|date_modify('+4 days')|date('d/m/Y') }}</td>
                            <td>
                                {% if entry.isApproved %}
                                    <span class="badge bg-success">Approved</span>
                                {% elseif entry.isManagerApproved %}
                                    <span class="badge bg-warning text-dark">Manager Approved - Pending HR</span>
                                {% elseif entry.isSupervisorApproved %}
                                    <span class="badge bg-info">Supervisor Approved</span>
                                {% elseif entry.isRejected %}
                                    <a href="{{ path('weekly_submission_staff_week', {id: entry.id}) }}" class="text-decoration-none">
                                        <span class="badge bg-danger">Rejected</span>
                                    </a>
                                {% elseif entry.isSubmitted %}
                                    <span class="badge bg-primary">Submitted</span>
                                {% else %}
                                    <span class="badge bg-secondary" style="color:#fff !important;">Draft</span>
                                {% endif %}
                                {% if entry.isOvertime %}
                                    <span class="badge bg-warning text-dark">Overtime</span>
                                {% endif %}
                            </td>
                            <td>{{ entry.submittedAt ? entry.submittedAt|date('d/m/Y') : '-' }}</td>
                            <td>
                                {% if entry.isDraft %}
                                    {{ app.user.displayName }}
                                {% elseif entry.isRejected %}
                                    {{ app.user.displayName }}
                                {% elseif entry.isApproved %}
                                    {{ app.user.displayName }}
                                {% elseif entry.isManagerApproved %}
                                    HR (Human Resources)
                                {% elseif entry.isSupervisorApproved %}
                                    {{ entry.user.supervisor.supervisor ? entry.user.supervisor.supervisor.displayName : '-' }}
                                {% elseif entry.isSubmitted %}
                                    {{ entry.user.supervisor ? entry.user.supervisor.displayName : '-' }}
                                {% endif %}
                            </td>
                            <td>
                                {{ entry.managerNotes ?: (entry.supervisorNotes ?: '-') }}
                                {% if entry.isRejected %}
                                    <a href="{{ path('weekly_submission_staff_week', {id: entry.id}) }}" class="btn btn-sm btn-warning float-end">
                                        <i class="fas fa-edit"></i> Edit &amp; Resubmit
                                    </a>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endif %}

{% endblock %}
