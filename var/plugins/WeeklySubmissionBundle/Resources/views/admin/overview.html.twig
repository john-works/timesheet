{% extends 'base.html.twig' %}
{% import "macros/widgets.html.twig" as widgets %}

{% block main %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Weekly Submission Overview</h3>
                <div class="card-tools float-end">
                    <a id="export-pdf" href="{{ path('weekly_submission_admin_overview_pdf') }}" class="btn btn-danger btn-sm"><i class="fas fa-file-pdf"></i> Export PDF</a>
                    <a href="{{ path('weekly_submission_admin_index') }}" class="btn btn-secondary btn-sm"><i class="fas fa-list"></i> All Submissions</a>
                </div>
            </div>
            <div class="card-body p-0">
                {% if data|length == 0 %}
                    <div class="p-3">
                        <div class="alert alert-info mb-0">No users found.</div>
                    </div>
                {% else %}
                    <div class="p-3 pb-2 d-flex flex-wrap align-items-center gap-1" id="overview-filters">
                        <span class="me-1">Filter:</span>
                        <button type="button" class="btn btn-sm btn-secondary" data-filter="all">All</button>
                        <button type="button" class="btn btn-sm btn-outline-success" data-filter="submitted"><i class="fas fa-check-circle"></i> Submitted</button>
                        <button type="button" class="btn btn-sm btn-outline-warning" data-filter="rejected"><i class="fas fa-exclamation-triangle"></i> Rejected</button>
                        <button type="button" class="btn btn-sm btn-outline-danger" data-filter="missing"><i class="fas fa-times-circle"></i> Not submitted</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-filter="empty"><i class="fas fa-minus-circle"></i> No timesheet data</button>
                        <div class="dropdown ms-2" id="dept-dropdown">
                            <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" id="dept-dropdown-btn">All departments</button>
                            <ul class="dropdown-menu p-2" style="max-height: 320px; overflow-y: auto; min-width: 300px;">
                                {% for dept in departments %}
                                    <li>
                                        <label class="dropdown-item d-flex align-items-center gap-2 mb-1">
                                            <input class="form-check-input flex-shrink-0 dept-check" type="checkbox" value="{{ dept }}" {% if dept in initialDepts %}checked{% endif %}>
                                            <span>{{ dept }}</span>
                                        </label>
                                    </li>
                                {% endfor %}
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button type="button" class="dropdown-item text-center small" id="dept-clear">All departments</button>
                                </li>
                            </ul>
                        </div>
                        <select id="month-filter" class="form-select form-select-sm ms-2" style="max-width: 160px;" aria-label="Filter by month">
                            <option value="">All months</option>
                            {% for month in availableMonths %}
                                <option value="{{ month.value }}" {% if month.value == initialMonth %}selected{% endif %}>{{ month.label }}</option>
                            {% endfor %}
                        </select>
                        <span class="badge bg-primary text-white ms-2">Current week highlighted</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered mb-0" data-current-week="{{ currentWeekStart|date('Y-m-d') }}">
                            <thead>
                                <tr>
                                    <th class="align-middle">Staff</th>
                                    <th class="align-middle">Department</th>
                                    {% for week in weeks %}
                                        <th class="text-center align-middle {{ week|date('Y-m-d') == currentWeekStart|date('Y-m-d') ? 'table-primary' : '' }}" data-week="{{ week|date('Y-m-d') }}" title="{{ week|date('d/m/Y') }} - {{ week|date_modify('+4 days')|date('d/m/Y') }}">
                                            {{ week|date('d/m') }}<br>
                                            <small class="fw-normal">{{ week|date('M') }}</small>
                                        </th>
                                    {% endfor %}
                                </tr>
                            </thead>
                            <tbody>
                                {% for entry in data %}
                                    {% set uid = entry.user.id %}
                                    <tr data-dept="{{ entry.department }}">
                                        <td class="text-nowrap">{{ entry.user.displayName }}</td>
                                        <td class="text-nowrap"><small>{{ entry.department }}</small></td>
                                        {% for week in weeks %}
                                            {% set key = week|date('Y-m-d') %}
                                            {% set cell = entry.cells[key] %}
                                            {% set isCurrent = key == currentWeekStart|date('Y-m-d') %}
                                            {% if cell.type == 'submitted' %}
                                                <td class="text-center table-success {{ isCurrent ? 'table-primary' : '' }}" data-type="submitted" data-week="{{ key }}">
                                                    <i class="fas fa-check-circle text-success" data-bs-toggle="tooltip" title="Submitted{{ cell.hours > 0 ? ' - ' ~ (cell.hours / 3600)|number_format(2) ~ 'h' : '' }}"></i>
                                                </td>
                                            {% elseif cell.type == 'rejected' %}
                                                <td class="text-center table-warning {{ isCurrent ? 'table-primary' : '' }}" data-type="rejected" data-week="{{ key }}">
                                                    <i class="fas fa-exclamation-triangle text-warning" data-bs-toggle="tooltip" title="Rejected - needs resubmission{{ cell.hours > 0 ? ' (' ~ (cell.hours / 3600)|number_format(2) ~ 'h)' : '' }}"></i>
                                                </td>
                                            {% elseif cell.type == 'missing' %}
                                                <td class="text-center table-danger {{ isCurrent ? 'table-primary' : '' }}" data-type="missing" data-week="{{ key }}">
                                                    <i class="fas fa-times-circle text-danger" data-bs-toggle="tooltip" title="Not submitted - {{ (cell.hours / 3600)|number_format(2) }}h recorded"></i>
                                                </td>
                                            {% else %}
                                                <td class="text-center {{ isCurrent ? 'table-primary' : '' }}" data-type="empty" data-week="{{ key }}">
                                                    <span class="text-muted" data-bs-toggle="tooltip" title="No timesheet data">-</span>
                                                </td>
                                            {% endif %}
                                        {% endfor %}
                                    </tr>
                                {% endfor %}
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold">
                                    <td colspan="2">Submitted</td>
                                    {% for week in weeks %}
                                        {% set key = week|date('Y-m-d') %}
                                        <td class="text-center {{ week|date('Y-m-d') == currentWeekStart|date('Y-m-d') ? 'table-primary' : '' }}" data-footer-week="{{ key }}">
                                            {{ weekSubmitted[key] }}/{{ weekTotal[key] }}
                                        </td>
                                    {% endfor %}
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(function () {
    var filterBar = document.getElementById('overview-filters');
    if (!filterBar) return;
    var table = document.querySelector('[data-current-week]');
    var rows = table.querySelectorAll('tbody tr');
    var footCells = table.querySelectorAll('[data-footer-week]');
    var currentWeek = table.dataset.currentWeek;

    var styles = {
        all: ['btn-outline-secondary', 'btn-secondary'],
        submitted: ['btn-outline-success', 'btn-success'],
        rejected: ['btn-outline-warning', 'btn-warning'],
        missing: ['btn-outline-danger', 'btn-danger'],
        empty: ['btn-outline-secondary', 'btn-secondary']
    };

    var buttons = filterBar.querySelectorAll('[data-filter]');
    var deptChecks = filterBar.querySelectorAll('.dept-check');
    var deptBtn = document.getElementById('dept-dropdown-btn');
    var deptClear = document.getElementById('dept-clear');
    var monthSelect = document.getElementById('month-filter');
    var currentStatus = 'all';
    var exportPdf = document.getElementById('export-pdf');
    var exportBase = exportPdf ? exportPdf.getAttribute('href').split('?')[0] : null;

    var params = new URLSearchParams(window.location.search);
    var initialStatus = params.get('status');
    if (initialStatus && styles[initialStatus]) {
        currentStatus = initialStatus;
    }

    function selectedDepts() {
        var out = [];
        deptChecks.forEach(function (check) {
            if (check.checked) out.push(check.value);
        });
        return out;
    }

    function buildQuery(status, depts, month) {
        var query = new URLSearchParams();
        if (status !== 'all') query.set('status', status);
        depts.forEach(function (dept) { query.append('dept[]', dept); });
        if (month !== '') query.set('month', month);
        var str = query.toString();
        return str ? '?' + str : '';
    }

    function updateButtons(filter) {
        buttons.forEach(function (btn) {
            var f = btn.dataset.filter;
            var pair = styles[f] || styles.all;
            btn.classList.remove(pair[0], pair[1]);
            btn.classList.add(f === filter ? pair[1] : pair[0]);
        });
    }

    function cellForWeek(row, week) {
        var found = null;
        row.querySelectorAll('td[data-type]').forEach(function (td) {
            if (!found && td.dataset.week === week) found = td;
        });
        return found;
    }

    function applyFilter() {
        var depts = selectedDepts();
        var month = monthSelect ? monthSelect.value : '';

        if (deptBtn) {
            deptBtn.textContent = depts.length === 0
                ? 'All departments'
                : (depts.length === 1 ? depts[0] : depts.length + ' departments');
        }

        var visibleWeek = {};
        table.querySelectorAll('thead th[data-week]').forEach(function (th) {
            var week = th.dataset.week;
            var show = month === '' || week.substring(0, 7) === month;
            visibleWeek[week] = show;
            th.style.display = show ? '' : 'none';
        });

        rows.forEach(function (row) {
            var show = depts.length === 0 || depts.indexOf(row.dataset.dept) !== -1;
            if (show && currentStatus !== 'all') {
                var cell = cellForWeek(row, currentWeek);
                show = cell !== null && cell.dataset.type === currentStatus;
            }
            row.style.display = show ? '' : 'none';

            row.querySelectorAll('td[data-week]').forEach(function (td) {
                td.style.display = visibleWeek[td.dataset.week] ? '' : 'none';
            });
        });

        footCells.forEach(function (td) {
            var week = td.dataset.footerWeek;
            if (visibleWeek[week] === false) {
                td.style.display = 'none';
                return;
            }
            td.style.display = '';
            var submitted = 0;
            var total = 0;
            rows.forEach(function (row) {
                if (row.style.display === 'none') return;
                var cell = cellForWeek(row, week);
                if (cell === null) return;
                total++;
                if (cell.dataset.type === 'submitted') submitted++;
            });
            td.textContent = submitted + '/' + total;
        });

        var query = buildQuery(currentStatus, depts, month);
        if (exportPdf) exportPdf.href = exportBase + query;
        if (window.history && window.history.replaceState) {
            window.history.replaceState(null, '', window.location.pathname + query + window.location.hash);
        }
        updateButtons(currentStatus);
    }

    buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
            currentStatus = btn.dataset.filter;
            applyFilter();
        });
    });

    deptChecks.forEach(function (check) {
        check.addEventListener('change', applyFilter);
    });

    if (deptClear) {
        deptClear.addEventListener('click', function () {
            deptChecks.forEach(function (check) { check.checked = false; });
            applyFilter();
        });
    }

    if (monthSelect) {
        monthSelect.addEventListener('change', applyFilter);
    }

    applyFilter();

    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
        if (!bootstrap.Tooltip.getInstance(el)) {
            new bootstrap.Tooltip(el);
        }
    });
})();
</script>
{% endblock %}
