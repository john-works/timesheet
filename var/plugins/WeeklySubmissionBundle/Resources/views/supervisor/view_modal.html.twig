<div class="row mb-3">
    <div class="col-md-4">
        <strong>Staff:</strong> {{ submission.user.displayName }}
    </div>
    <div class="col-md-4">
        <strong>Total:</strong>
        <span class="badge bg-primary" style="color: #fff !important;">{{ (totalDuration / 3600)|number_format(2) }}h</span>
    </div>
</div>

{% if submission.managerNotes %}
{% if submission.isRejected %}
<div class="alert alert-danger">
    <strong>Manager rejected — reason:</strong><br>
    {{ submission.managerNotes|nl2br }}
</div>
{% else %}
<div class="alert alert-info">
    <strong>Manager notes:</strong><br>
    {{ submission.managerNotes|nl2br }}
</div>
{% endif %}
{% endif %}

{% for week in weekData %}
<div class="mb-4">
    <h5 class="border-bottom pb-2">
        {{ week.weekStart|date('d/m/Y') }} - {{ week.weekEnd|date('d/m/Y') }}
        <span class="badge bg-secondary ms-2" style="color:#fff !important;">{{ (week.totalDuration / 3600)|number_format(2) }}h</span>
    </h5>

    {% if week.timesheets|length == 0 %}
        <div class="alert alert-info">No timesheet entries found.</div>
    {% else %}
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Project</th>
                    <th>Activity</th>
                    <th>Description</th>
                    <th>Start Time</th>
                    <th>End Time</th>
                </tr>
            </thead>
            <tbody>
                {% for entry in week.timesheets %}
                {% set isLeave = entry.activity is not null and entry.activity.name|lower == 'leave' %}
                <tr class="{{ isLeave ? 'table-info' : '' }}">
                    <td>{{ entry.begin|date('d/m/Y') }}</td>
                    <td>{{ entry.project ? entry.project.name : '-' }}</td>
                    <td>
                        {{ entry.activity ? entry.activity.name : '-' }}
                        {% if isLeave %}
                            <span class="badge bg-info" style="color: #fff !important;">On Leave</span>
                        {% endif %}
                    </td>
                    <td>
                        {% set taskData = entry.description|json_decode %}
                        {% if taskData is iterable %}
                            {% for taskItem in taskData %}
                                {{ loop.index }}. {{ taskItem.task }}{% if taskItem.status is defined and taskItem.status %} ({% if taskItem.status|lower == 'completed' %}<span style="color:green">{{ taskItem.status }}</span>{% elseif taskItem.status|lower == 'in progress' %}<span style="color:blue">{{ taskItem.status }}</span>{% elseif taskItem.status|lower == 'pending' %}<span style="color:orange">{{ taskItem.status }}</span>{% else %}{{ taskItem.status }}{% endif %}){% endif %}{% if not loop.last %}<br>{% endif %}
                            {% endfor %}
                        {% else %}
                            {{ entry.description|nl2br }}
                        {% endif %}
                    </td>
                    <td>{{ entry.begin|date('h:i A') }}</td>
                    <td>{{ entry.end ? entry.end|date('h:i A') : '-' }}</td>
                </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr class="fw-bold">
                    <td colspan="5" class="text-end">Total:</td>
                    <td>{{ (week.totalDuration / 3600)|number_format(2) }}h</td>
                </tr>
            </tfoot>
        </table>
    {% endif %}
</div>
{% endfor %}
