                                                        {% for s in group.submissions %}
                                                            <br>{{ s.weekStart|date('d/m/Y') }} - {{ s.weekStart|date_modify('+4 days')|date('d/m/Y') }} ({{ (s.totalDuration / 3600)|number_format(2) }}h)
                                                        {% endfor %}
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="hrRejectNotes{{ group.user.id }}" class="form-label">Reason for rejection <span class="text-danger">*</span></label>
                                                        <textarea id="hrRejectNotes{{ group.user.id }}" name="notes" class="form-control" rows="3" required></textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-danger" onclick="setTimeout(() => this.disabled = true, 0)">Confirm Reject</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endif %}

<style>
.actions-cell { white-space: nowrap; }
.actions-cell .dropdown-item:hover { background:#0056b3; color:#fff !important; }
.actions-cell .dropdown-item:hover i { color:#fff !important; }
</style>
{% endblock %}
