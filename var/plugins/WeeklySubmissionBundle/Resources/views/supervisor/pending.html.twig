{% extends 'base.html.twig' %}
{% import "macros/widgets.html.twig" as widgets %}

{% block main %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Pending My Approval</h3>
            </div>
            <div class="card-body p-0">
                {% if groupedSubmissions|length == 0 %}
                    <div class="p-3">
                        <div class="alert alert-info mb-0">No pending submissions from your direct reports.</div>
                    </div>
                {% else %}
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Staff</th>
                                <th>Week(s)</th>
                                <th>Total Hours</th>
                                <th>Submitted</th>
                                <th>Stage</th>
                                {% if isAdmin %}
                                <th>Reassign To</th>
                                {% endif %}
                                <th>Comment</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for group in groupedSubmissions %}
                            {% set firstSubmission = group.submissions|first %}
                            {% set lastSubmission = group.submissions|last %}
                            <tr>
                                <td>{{ group.user.displayName }}</td>
                                <td>
                                    {% if group.submissions|length == 1 %}
                                        {{ firstSubmission.weekStart|date('d/m/Y') }} - {{ firstSubmission.weekStart|date_modify('+4 days')|date('d/m/Y') }}
                                    {% else %}
                                        {{ firstSubmission.weekStart|date('d/m/Y') }} - {{ lastSubmission.weekStart|date_modify('+4 days')|date('d/m/Y') }}
                                        <br><small class="text-muted">({{ group.submissions|length }} weeks)</small>
                                    {% endif %}
                                </td>
                                <td>
                                    {% set hours = (group.totalDuration / 3600)|number_format(2) %}{{ hours }}h
                                    {% set hasOvertime = false %}
                                    {% for s in group.submissions %}
                                        {% if s.isOvertime %}{% set hasOvertime = true %}{% endif %}
                                    {% endfor %}
                                    {% if hasOvertime %}
                                        {% set totalOvertime = 0 %}
                                        {% for s in group.submissions %}{% set totalOvertime = totalOvertime + s.overtimeHours %}{% endfor %}
                                        <span class="badge bg-warning" style="color: #fff !important;">Overtime: {{ totalOvertime }}h</span>
                                    {% endif %}
                                </td>
                                <td>{{ group.submittedAt ? group.submittedAt|date('d/m/Y H:i') : '-' }}</td>
                                <td>
                                    {% if firstSubmission.isSubmitted %}
                                        {{ firstSubmission.reassignedTo ? firstSubmission.reassignedTo.displayName : (group.user.supervisor ? group.user.supervisor.displayName : 'Unassigned') }}
                                    {% elseif firstSubmission.isSupervisorApproved %}
                                        {{ firstSubmission.reassignedTo ? firstSubmission.reassignedTo.displayName : (group.user.supervisor.supervisor ? group.user.supervisor.supervisor.displayName : 'Unassigned') }}
                                    {% elseif firstSubmission.isManagerApproved %}
                                        Manager HR (Overtime)
                                    {% elseif firstSubmission.isHrApproved %}
                                        HR/Admin (Final)
                                    {% elseif firstSubmission.isApproved %}
                                        Fully Approved
                                    {% elseif firstSubmission.isRejected %}
                                        Rejected
                                    {% endif %}
                                </td>
                                {% if isAdmin %}
                                <td>
                                    {% set deptUsers = departmentUsersMap[firstSubmission.id] ?? [] %}
                                    {% if deptUsers|length > 0 %}
                                    <form action="{{ path('weekly_submission_supervisor_reassign', {id: firstSubmission.id}) }}" method="post" class="d-flex gap-1">
                                        <select name="new_supervisor_id" class="form-control form-control-sm" style="min-width:130px" required>
                                            {% for u in deptUsers %}
                                                <option value="{{ u.id }}" {% if group.reassignedTo and group.reassignedTo.id == u.id %}selected{% endif %}>{{ u.displayName }}</option>
                                            {% endfor %}
                                        </select>
                                        <button type="submit" class="btn btn-warning btn-sm"><i class="fas fa-exchange-alt"></i></button>
                                    </form>
                                    {% else %}
                                    <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                {% endif %}
                                <td>{{ firstSubmission.managerNotes ?: (firstSubmission.supervisorNotes ?: '-') }}</td>
                                <td class="actions-cell">
                                    <div class="dropdown">
                                        <a href="#" data-bs-toggle="dropdown" style="text-decoration:none">
                                            <i class="fas fa-bars" style="color:blue"></i>
                                        </a>
                                        <div class="dropdown-menu dropdown-menu-right">
                                            {% set viewIds = group.submissions|map(s => s.id)|join(',') %}
                            <a href="{{ path('weekly_submission_supervisor_view_modal', {id: firstSubmission.id, ids: viewIds}) }}" class="dropdown-item remote-modal-load" data-modal-title="Timesheet - {{ group.user.displayName }}" data-modal-class="p-0">
                                                <i class="fas fa-eye" style="color:#0056b3;width:1.5rem"></i> View
                                            </a>
                                            {% if group.allActable %}
                                            <div class="dropdown-divider"></div>
                                            <a href="#" class="dropdown-item" onclick="event.preventDefault();" data-bs-toggle="modal" data-bs-target="#batchApproveModal{{ group.user.id }}">
                                                <i class="fas fa-check" style="color:#28a745;width:1.5rem"></i> Approve All
                                            </a>
                                            <a href="#" class="dropdown-item" onclick="event.preventDefault();" data-bs-toggle="modal" data-bs-target="#batchRejectModal{{ group.user.id }}">
                                                <i class="fas fa-times" style="color:#dc3545;width:1.5rem"></i> Reject All
                                            </a>
                                            {% endif %}
                                        </div>
                                    </div>

                                    <div class="modal fade" id="batchApproveModal{{ group.user.id }}" tabindex="-1">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <form action="{{ path('weekly_submission_supervisor_batch_approve') }}" method="post">
                                                    {% for s in group.submissions %}
                                                    <input type="hidden" name="ids[]" value="{{ s.id }}">
                                                    {% endfor %}
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Approve - {{ group.user.displayName }}</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <div class="mb-3">
                                                            <strong>Weeks:</strong>
                                                            {% for s in group.submissions %}
                                                                <br>{{ s.weekStart|date('d/m/Y') }} - {{ s.weekStart|date_modify('+4 days')|date('d/m/Y') }} ({{ (s.totalDuration / 3600)|number_format(2) }}h)
                                                            {% endfor %}
                                                        </div>
                                                        <div class="mb-3">
                                                            <strong>Total hours:</strong> {{ (group.totalDuration / 3600)|number_format(2) }}h
                                                        </div>
                                                        <div class="mb-3">
                                                            <label for="approveNotes{{ group.user.id }}" class="form-label">Notes <span class="text-danger">*</span></label>
                                                            <textarea id="approveNotes{{ group.user.id }}" name="notes" class="form-control" rows="3" required></textarea>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-success">Confirm Approve</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="modal fade" id="batchRejectModal{{ group.user.id }}" tabindex="-1">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <form action="{{ path('weekly_submission_supervisor_batch_reject') }}" method="post">
                                                    {% for s in group.submissions %}
                                                    <input type="hidden" name="ids[]" value="{{ s.id }}">
                                                    {% endfor %}
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Reject - {{ group.user.displayName }}</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <div class="mb-3">
                                                            <strong>Weeks:</strong>
                                                            {% for s in group.submissions %}
                                                                <br>{{ s.weekStart|date('d/m/Y') }} - {{ s.weekStart|date_modify('+4 days')|date('d/m/Y') }} ({{ (s.totalDuration / 3600)|number_format(2) }}h)
                                                            {% endfor %}
                                                        </div>
                                                        <div class="mb-3">
                                                            <label for="rejectNotes{{ group.user.id }}" class="form-label">Reason for rejection <span class="text-danger">*</span></label>
                                                            <textarea id="rejectNotes{{ group.user.id }}" name="notes" class="form-control" rows="3" required></textarea>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-danger" onclick="setTimeout(() => this.disabled = true, 0)">Confirm Reject</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
        </div>
    </div>
</div>

