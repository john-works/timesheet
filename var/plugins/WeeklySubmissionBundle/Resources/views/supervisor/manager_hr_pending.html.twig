{% extends 'base.html.twig' %}

{% block main %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Awaiting Manager HR Approval (Overtime)</h3>
                <div class="card-tools">
                    <span class="badge bg-warning" style="color: #fff !important;">{{ groupedManagerHrSubmissions|length }} pending</span>
                </div>
            </div>
            <div class="card-body p-0">
                {% if groupedManagerHrSubmissions|length == 0 %}
                    <div class="p-3">
                        <div class="alert alert-info mb-0">No overtime submissions pending your approval.</div>
                    </div>
                {% else %}
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Staff</th>
                                <th>Week(s)</th>
                                <th>Total Hours</th>
                                <th>Overtime</th>
                                <th>Approved At</th>
                                <th>Comment</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for group in groupedManagerHrSubmissions %}
                            {% set firstSubmission = group.submissions|first %}
                            {% set viewIds = group.submissions|map(s => s.id)|join(',') %}
                            {% set totalOvertime = 0 %}{% for s in group.submissions %}{% set totalOvertime = totalOvertime + s.overtimeHours %}{% endfor %}
                            <tr>
                                <td>{{ group.user.displayName }}</td>
                                <td>
                                    {% if group.submissions|length == 1 %}
                                        {{ firstSubmission.weekStart|date('d/m/Y') }} - {{ firstSubmission.weekStart|date_modify('+4 days')|date('d/m/Y') }}
                                    {% else %}
                                        {{ firstSubmission.weekStart|date('d/m/Y') }} - {{ group.submissions|last.weekStart|date_modify('+4 days')|date('d/m/Y') }}
                                        <br><small class="text-muted">({{ group.submissions|length }} weeks)</small>
                                    {% endif %}
                                </td>
                                <td>{{ (group.totalDuration / 3600)|number_format(2) }}h</td>
                                <td><span class="badge bg-warning" style="color: #fff !important;">{{ totalOvertime }}h overtime</span></td>
                                <td>{{ firstSubmission.approvedAt ? firstSubmission.approvedAt|date('d/m/Y H:i') : '-' }}</td>
                                <td>{{ firstSubmission.managerNotes ?: (firstSubmission.supervisorNotes ?: '-') }}</td>
                                <td class="actions-cell">
                                    <div class="dropdown">
                                        <a href="#" data-bs-toggle="dropdown" style="text-decoration:none">
                                            <i class="fas fa-bars" style="color:blue"></i>
                                        </a>
                                        <div class="dropdown-menu dropdown-menu-right">
                                            <a href="{{ path('weekly_submission_supervisor_view_modal', {id: firstSubmission.id, ids: viewIds}) }}" class="dropdown-item remote-modal-load" data-modal-title="Timesheet - {{ group.user.displayName }}" data-modal-class="p-0">
                                                <i class="fas fa-eye" style="color:#0056b3;width:1.5rem"></i> View
                                            </a>
                                            {% if group.allActable %}
                                            <div class="dropdown-divider"></div>
                                            <a href="#" class="dropdown-item" onclick="event.preventDefault();" data-bs-toggle="modal" data-bs-target="#batchManagerHrApproveModal{{ group.user.id }}">
                                                <i class="fas fa-check" style="color:#28a745;width:1.5rem"></i> Approve All
                                            </a>
                                            <a href="#" class="dropdown-item" onclick="event.preventDefault();" data-bs-toggle="modal" data-bs-target="#batchManagerHrRejectModal{{ group.user.id }}">
                                                <i class="fas fa-times" style="color:#dc3545;width:1.5rem"></i> Reject All
                                            </a>
                                            {% endif %}
                                        </div>
                                    </div>

                                    <div class="modal fade" id="batchManagerHrApproveModal{{ group.user.id }}" tabindex="-1">
                                        <div class="modal-dialog modal-lg">
                                            <div class="modal-content">
                                                <form action="{{ path('weekly_submission_supervisor_batch_approve') }}" method="post">
                                                    {% for s in group.submissions %}
                                                    <input type="hidden" name="ids[]" value="{{ s.id }}">
                                                    {% endfor %}
                                                    <div class="modal-header bg-success text-white">
                                                        <h5 class="modal-title">Approve Overtime - {{ group.user.displayName }}</h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <table class="table table-sm table-bordered mb-3">
                                                            <thead>
                                                                <tr><th>Week</th><th>Hours</th><th>Overtime</th></tr>
                                                            </thead>
                                                            <tbody>
                                                            {% for s in group.submissions %}
                                                                <tr>
                                                                    <td>{{ s.weekStart|date('d/m/Y') }} - {{ s.weekStart|date_modify('+4 days')|date('d/m/Y') }}</td>
                                                                    <td>{{ (s.totalDuration / 3600)|number_format(2) }}h</td>
                                                                    <td><span class="badge bg-warning" style="color: #fff !important;">{{ s.overtimeHours }}h</span></td>
                                                                </tr>
                                                            {% endfor %}
                                                            </tbody>
                                                        </table>
                                                        <div class="mb-3">
                                                            <label for="managerHrNotes{{ group.user.id }}" class="form-label">Notes <span class="text-danger">*</span></label>
                                                            <textarea id="managerHrNotes{{ group.user.id }}" name="notes" class="form-control" rows="3" required></textarea>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-success">Confirm Approve</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="modal fade" id="batchManagerHrRejectModal{{ group.user.id }}" tabindex="-1">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <form action="{{ path('weekly_submission_supervisor_batch_reject') }}" method="post">
                                                    {% for s in group.submissions %}
                                                    <input type="hidden" name="ids[]" value="{{ s.id }}">
                                                    {% endfor %}
                                                    <div class="modal-header bg-danger text-white">
                                                        <h5 class="modal-title">Reject Overtime - {{ group.user.displayName }}</h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <div class="mb-3">
                                                            <strong>Weeks:</strong>
                                                            {% for s in group.submissions %}
                                                                <br>{{ s.weekStart|date('d/m/Y') }} - {{ s.weekStart|date_modify('+4 days')|date('d/m/Y') }} ({{ (s.totalDuration / 3600)|number_format(2) }}h)
                                                            {% endfor %}
                                                        </div>
                                                        <div class="mb-3">
                                                            <label for="managerHrRejectNotes{{ group.user.id }}" class="form-label">Reason for rejection <span class="text-danger">*</span></label>
                                                            <textarea id="managerHrRejectNotes{{ group.user.id }}" name="notes" class="form-control" rows="3" required></textarea>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-danger" onclick="setTimeout(() => this.disabled = true, 0)">Confirm Reject</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<style>
.actions-cell { white-space: nowrap; }
.actions-cell .dropdown-item:hover { background:#0056b3; color:#fff !important; }
.actions-cell .dropdown-item:hover i { color:#fff !important; }
</style>
{% endblock %}